{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/portfolio/frontend/assets/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/portfolio/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/portfolio/frontend/js/$1"
    },
    {
      "source": "/",
      "destination": "/portfolio/frontend/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/portfolio/frontend/$1"
    }
  ]
}
